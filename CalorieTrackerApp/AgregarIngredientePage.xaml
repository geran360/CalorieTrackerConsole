<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTrackerApp.AgregarIngredientePage"
             Title="Agregar Alimento">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Agregar un Alimento" 
           FontSize="16" />

        <Entry x:Name="entradaAlimento"
           Placeholder="Escribe el alimento"
           FontSize="18"
           ClearButtonVisibility="WhileEditing" />

        <Entry x:Name="entradaCalorias"
           Placeholder="Escribe las calorias"
           FontSize="18"
           ClearButtonVisibility="WhileEditing" />

        <Button Text="Guardar" 
             BackgroundColor="SeaGreen"
             TextColor="White"
             CornerRadius="8"
             HeightRequest="45"
             WidthRequest="200"
             HorizontalOptions="Center"
            Clicked="btnEnviarAlimento" />

    </VerticalStackLayout>
</ContentPage>